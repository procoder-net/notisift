# Optional build-time defaults. Copy to .env (git-ignored) and fill in what you need.
# Everything here can also be set in the app under Settings → Advanced.

# One key is enough; NotiSift detects the provider from its name or prefix.
# The key is compiled into DEBUG builds only (see README).
PERPLEXITY_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Optional overrides.
# SIFT_PROVIDER=
# SIFT_BASE_URL=
# SIFT_MODEL=

# Never set this for an APK you share: it puts your key inside the release build.
# SIFT_EMBED_KEY_IN_RELEASE=false
